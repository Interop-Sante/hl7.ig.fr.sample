@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<http://hl7.fr/fhir/fr/example/Patient/frpatient-exemple> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "frpatient-exemple"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "http://hl7.fr/fhir/fr/example/StructureDefinition/fr-patient" ;
       fhir:index 0 ;
       fhir:link <http://hl7.fr/fhir/fr/example/StructureDefinition/fr-patient>
     ]
  ] ;
  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Narratif généré : Patient frpatient-exemple</b></p><a name=\"frpatient-exemple\"> </a><a name=\"hcfrpatient-exemple\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profil: <a href=\"StructureDefinition-fr-patient.html\">Patient français</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">Patient Anonyme Male, Date de Naissance inconnue</p><hr/></div>"
  ] ;
  fhir:Patient.gender [ fhir:value "male"] .

# - ontology header ------------------------------------------------------------

<http://hl7.fr/fhir/fr/example/Patient/frpatient-exemple.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

